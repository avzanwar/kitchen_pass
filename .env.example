# Copy to .env and fill in before `docker compose up`.

# REQUIRED. Generate with: openssl rand -hex 32
KP_SECRET_KEY=

# Postgres password for the bundled database container.
POSTGRES_PASSWORD=change-me

# Where the web UI is served from; must match how browsers reach it.
WEB_PORT=8080
KP_CORS_ORIGINS=http://localhost:8080
