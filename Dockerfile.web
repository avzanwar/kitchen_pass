# Build context is the repo root, because the web build needs ../conformance
# for the engine conformance test.
FROM node:22-alpine AS build
WORKDIR /build

COPY web/package.json web/package-lock.json* ./web/
RUN cd web && npm ci

COPY web ./web
COPY conformance ./conformance

# A build that ships an engine which disagrees with the server is worse than no
# build, so the conformance suite gates the image.
RUN cd web && npx vitest run && npm run build

FROM nginx:1.27-alpine
COPY --from=build /build/web/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
